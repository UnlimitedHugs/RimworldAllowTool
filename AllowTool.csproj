<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>NU1603</NoWarn>
    <RootNamespace>AllowTool</RootNamespace>
    <AssemblyName>AllowTool</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Optimize>true</Optimize>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>Mods\AllowTool\v1.7\Assemblies\</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <RimWorldVersion>1.7.4985-unstable</RimWorldVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source\**\*.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldVersion)" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" ExcludeAssets="runtime" />
    <!-- HugsLib 13 (net10.0) from https://github.com/anatolix/RimworldHugsLib ; upstream NuGet package is still the net472 build -->
    <Reference Include="HugsLib"><HintPath>lib\HugsLib\HugsLib.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
